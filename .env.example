# Copy to .env (chmod 600). .env is gitignored — never commit it.
# AHGFamily login used by scripts/fetch-ahgfamily-catalog.js. The scripts only
# READ from AHGFamily (GET pages + the badge-tracker-view fragment); they never
# write. Credentials are never printed or written to disk by the scripts.
AHG_EMAIL=leader@example.com
AHG_PASSWORD=fake-password-never-real

# Optional overrides (defaults shown)
# AHG_BASE=https://www.ahgfamily.org
# AHG_LOGIN_PATH=/login
# AHG_THROTTLE_MS=300
# DATA_DIR=./data
# Keep the raw HTML fragment beside each award JSON for parser debugging
# (data/ is gitignored, but the fragments contain a youth id — leave off unless needed).
# AHG_KEEP_RAW=false
# Print every request's path + status + redirect target to stderr (no cookies, no bodies)
# AHG_DEBUG=1

# ---------------------------------------------------------------------------
# Tracker service (server/) — docs/tracker-service-spec.md, docs/entra-setup.md
# PORT=3100                       # 127.0.0.1 only; Cloudflare Tunnel fronts it
# DATA_DIR=./data                 # tracker.db, badges/, backups
# BADGES_DIR=./data/badges        # built badges from scripts/build-badges.js
# SITE_ORIGIN=https://troop.example.org   # the ONE origin allowed for CORS
# TZ=America/New_York
# MSAL_TENANT_ID=00000000-0000-0000-0000-000000000000
# MSAL_CLIENT_ID=00000000-0000-0000-0000-000000000000   # the TRACKER app registration (not the website's)
# MSAL_SCOPE=access_as_leader
# LEADER_GROUP_ID=                # security group object id (recommended) …
# LEADER_EMAILS=leader@example.com,other@example.com   # … or an allow-list
# ADMIN_EMAILS=admin@example.com  # subset of leaders who may change settings / push
# AUTH_DISABLED=false             # true = every request is a fake admin; dev only, ignored in production

# Check-in app Integration API (same Pi; read-only by contract) — key and
# webhook secret come from the check-in app's Admin -> Integrations tab.
# CHECKIN_BASE=http://127.0.0.1:3000
# CHECKIN_API_KEY=tci_...
# CHECKIN_WEBHOOK_SECRET=...      # webhook target: http://127.0.0.1:3100/webhooks/checkin

# CRED_KEY is auto-generated into .env on the first AHGFamily credential save
# (server/lib/credcrypto.js) — never set it by hand, never commit it.

# Dev-only switches (never on the Pi service)
# DISABLE_SCHEDULER=true          # skip all background jobs for a hand-run server

# Push run report (server/lib/report.js) — mailed after every AHGFamily push
# run (weekly or "Push now") to REPORT_EMAILS. All three must be set to send;
# otherwise the report is only kept for the admin page. SMTP_URL is a
# nodemailer URL, e.g. smtps://user%40example.org:app-password@smtp.office365.com:465
# or smtp://user:pass@smtp.example.org:587 (STARTTLS).
# SMTP_URL=
# REPORT_FROM=badge-tracker@example.org
# REPORT_EMAILS=coordinator@example.org,admin@example.org
